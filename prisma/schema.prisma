generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Emotion {
  Lonely
  Heartbroken
  Hopeful
  Grateful
  Anxious
  Confused
  Regretful
  Angry
  BurnedOut
  Loved
  Guilty
}

enum ReactionType {
  FELT
  WARMTH
}

enum NotificationType {
  REACT
  REPLY
  WARM
}

model User {
  id String @id @default(uuid())

  username String @unique
  password String

  bio String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  posts    Post[]
  comments Comment[]
  saved    SavedPost[]
  Likes    Like[]

  @@index([username])
}

model Post {
  id String @id @default(cuid())

  body String

  emotion           Emotion
  hasTriggerWarning Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id])
  userId String

  comments Comment[]
  savedBy  SavedPost[]
  Likes    Like[]
}

model Comment {
  id String @id @default(cuid())

  body String

  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id])
  userId String

  post   Post   @relation(fields: [postId], references: [id])
  postId String
}

model SavedPost {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  postId String
  post   Post   @relation(fields: [postId], references: [id])

  userId String
  user   User   @relation(fields: [userId], references: [id])
}

model Like {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  postId String
  post   Post   @relation(fields: [postId], references: [id])
}
